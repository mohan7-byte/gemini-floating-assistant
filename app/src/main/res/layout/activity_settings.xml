<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GEMINI FLOAT" android:textColor="@color/accent" android:textStyle="bold" android:letterSpacing="0.12" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Voice-first.\nThere when you call." android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="Native Android · Gemini Live audio-to-audio · No always-on floating button" android:textColor="@color/text_secondary" android:textSize="14sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="GOOGLE AI STUDIO API KEY" android:textColor="@color/accent" android:textStyle="bold" android:textSize="12sp" />
        <EditText android:id="@+id/etApiKey" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp"
            android:background="@drawable/input_background" android:hint="Paste your API key" android:inputType="textPassword|textNoSuggestions"
            android:paddingHorizontal="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Saved encrypted on this device. Never put the key in source code or GitHub." android:textColor="@color/text_secondary" android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="MODEL ID (EDITABLE)" android:textColor="@color/accent" android:textStyle="bold" android:textSize="12sp" />
        <EditText android:id="@+id/etModel" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp"
            android:background="@drawable/input_background" android:hint="gemini-3.8-live" android:inputType="textNoSuggestions"
            android:paddingHorizontal="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:singleLine="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Type any model ID enabled for your API key. Default: gemini-3.8-live. The selected model must support the Live API for realtime voice to work." android:textColor="@color/text_secondary" android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="24dp" android:text="Save settings" android:textAllCaps="false" android:textStyle="bold"
            android:textColor="@color/ink" android:backgroundTint="@color/accent" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="ONE-TIME SETUP" android:textColor="@color/accent" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="1 · Allow display over other apps so the compact control bar can appear.\n\n2 · Allow microphone permission for Gemini Live voice.\n\n3 · Enable Gemini Float Shortcut in Accessibility settings to use double-press Volume Down. Some phone firmwares may restrict hardware-key interception.\n\n4 · Double-press Volume Down to open Live voice, or tap Open Live assistant below. No floating icon stays on screen when disconnected."
            android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantOverlay" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp"
            android:text="Allow floating control bar" android:textAllCaps="false" android:textColor="@color/text_primary" android:backgroundTint="@color/panel_elevated" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantAccessibility" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp"
            android:text="Set up Volume Down shortcut" android:textAllCaps="false" android:textColor="@color/text_primary" android:backgroundTint="@color/panel_elevated" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnShowOrb" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp"
            android:text="Open Live assistant" android:textAllCaps="false" android:textColor="@color/text_primary" android:backgroundTint="@color/panel_elevated" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="20dp"
            android:text="Gemini Float is an independent personal project. Live voice and screenshots are sent to Google Gemini using your API key. Tap Disconnect to close the session and stop Live audio streaming."
            android:textColor="@color/text_secondary" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
