<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_background"
    android:elevation="18dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Always a single slim row while Live is active. No persistent floating orb. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/floating_orb" />

        <TextView
            android:id="@+id/tvModelBadge"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="7dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="gemini-3.8-live"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:paddingHorizontal="7dp"
            android:text="Mute"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnScreenshot"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="46dp"
            android:paddingHorizontal="6dp"
            android:text="Screen"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="5dp"
            android:text="Disconnect"
            android:textColor="@color/danger"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnExpand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/input_background"
            android:contentDescription="Show text input and transcript"
            android:text="↑"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hidden unless the user taps the up arrow. -->
    <LinearLayout
        android:id="@+id/expandedContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connecting to Gemini Live…"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <ScrollView
            android:id="@+id/responseScroll"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp"
            android:fillViewport="true">
            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Live transcript appears here."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/input_background"
                android:hint="Type to Gemini Live…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/floating_orb"
                android:gravity="center"
                android:text="↑"
                android:textColor="@color/accent"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
