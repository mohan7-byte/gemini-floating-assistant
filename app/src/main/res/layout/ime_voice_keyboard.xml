<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_background"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="4dp">

    <!-- Compact, Gboard-inspired toolbar. Every icon sits on the same surface. -->
    <LinearLayout
        android:id="@+id/imeHeader"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:text="Buddy keyboard" />
        <TextView
            android:id="@+id/btnLanguage"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Switch English or Hindi"
            android:gravity="center"
            android:text="🌐"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Keyboard settings"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/text_primary"
            android:textSize="21sp" />
        <TextView
            android:id="@+id/btnOfflineKeyboard"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Switch to keyboard"
            android:gravity="center"
            android:text="⌨"
            android:textColor="@color/text_primary"
            android:textSize="21sp" />
        <TextView
            android:id="@+id/btnTheme"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cycle keyboard theme"
            android:gravity="center"
            android:text="◕"
            android:textColor="@color/text_primary"
            android:textSize="23sp" />
        <TextView
            android:id="@+id/btnClipboard"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Open clipboard history"
            android:gravity="center"
            android:text="▤"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Start Gemini Live dictation"
            android:gravity="center"
            android:text="🎙"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/btnHideKeyboard"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.8"
            android:background="@android:color/transparent"
            android:contentDescription="Hide keyboard"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/text_primary"
            android:textSize="23sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/voicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/btnDictate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/action_chip"
            android:backgroundTint="@color/accent_dark"
            android:gravity="center"
            android:text="●  Start Gemini Live dictation"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/quickKeysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/btnCustomizeKeys"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="⚙ Quick keys"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/offlinePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/suggestionContainer"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/suggestion1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <View android:layout_width="1dp" android:layout_height="17dp" android:background="#263A414A" />
            <TextView
                android:id="@+id/suggestion2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <View android:layout_width="1dp" android:layout_height="17dp" android:background="#263A414A" />
            <TextView
                android:id="@+id/suggestion3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        <TextView
            android:id="@+id/btnToggleToolbar"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="Show keyboard toolbar"
            android:gravity="center"
            android:text="⌃"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <ScrollView
            android:id="@+id/clipboardScroll"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:fillViewport="false"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/clipboardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/settingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </ScrollView>
        <LinearLayout
            android:id="@+id/settingsActions"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/btnCancelKeyboardSettings"
                android:layout_width="88dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btnSaveKeyboardSettings"
                android:layout_width="88dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/action_chip"
                android:gravity="center"
                android:text="Save"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- Compatibility anchor for previous voice-panel toggle code. -->
        <View
            android:id="@+id/btnBackToVoice"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
