<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/panel_background" android:elevation="18dp" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/floating_orb" />
        <TextView android:id="@+id/tvModelBadge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="GEMINI FLOAT" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/btnMute" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="10dp" android:text="Mute" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/btnDisconnect" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="10dp" android:text="Disconnect" android:textColor="@color/danger" android:textSize="12sp" />
        <TextView android:id="@+id/btnClose" android:layout_width="32dp" android:layout_height="36dp" android:gravity="center" android:text="×" android:textColor="@color/text_primary" android:textSize="24sp" />
    </LinearLayout>
    <ScrollView android:id="@+id/responseScroll" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="8dp" android:fillViewport="true">
        <TextView android:id="@+id/tvResponse" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hey there. What can I help with?"
            android:textColor="@color/text_primary" android:textSize="14sp" android:lineSpacingExtra="3dp" android:padding="4dp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btnScreenshot" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/input_background"
            android:text="▧  Screenshot" android:textColor="@color/text_primary" android:textSize="12sp" />
        <TextView android:id="@+id/btnVoice" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/input_background"
            android:text="◉  Voice" android:textColor="@color/text_primary" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
        <EditText android:id="@+id/etPrompt" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/input_background"
            android:hint="Ask anything…" android:imeOptions="actionSend" android:inputType="textCapSentences|textMultiLine" android:maxLines="3"
            android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/floating_orb"
            android:gravity="center" android:text="↑" android:textColor="@color/accent" android:textSize="24sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ready"
        android:textColor="@color/text_secondary" android:textSize="11sp" />
</LinearLayout>
