<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GEMINI FLOAT VOICE"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnHideKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:text="Done"
            android:textAllCaps="false" />
    </LinearLayout>
    <TextView
        android:id="@+id/imeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tap Dictate to enter formatted text into the focused app."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
    <Button
        android:id="@+id/btnDictate"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/accent"
        android:text="●  Dictate"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
