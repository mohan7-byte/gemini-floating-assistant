<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_background"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/imeHeader"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingEnd="3dp"
            android:text="Buddy ready"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/btnLanguage"
            android:layout_width="38dp"
            android:layout_height="28dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Switch English or Hindi"
            android:gravity="center"
            android:text="EN"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnOfflineKeyboard"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Switch to offline keyboard"
            android:gravity="center"
            android:text="⌨"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/btnHideKeyboard"
            android:layout_width="34dp"
            android:layout_height="28dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Hide keyboard"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:background="#263A414A" />

    <LinearLayout
        android:id="@+id/voicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/btnDictate"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/action_chip"
            android:backgroundTint="@color/accent_dark"
            android:gravity="center"
            android:text="●  Start live dictation"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/quickKeysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/btnCustomizeKeys"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚙ Quick keys"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/offlinePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/suggestionContainer"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/suggestion1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:background="#263A414A" />
            <TextView
                android:id="@+id/suggestion2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:background="#263A414A" />
            <TextView
                android:id="@+id/suggestion3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="vertical" />
        <!-- Compatibility anchor for the old toggle code; intentionally not visible. -->
        <View
            android:id="@+id/btnBackToVoice"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
