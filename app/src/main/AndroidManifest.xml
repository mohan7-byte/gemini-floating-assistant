<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/buddy_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeminiFloat">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CapturePermissionActivity" android:exported="false" android:theme="@style/Theme.GeminiFloat" android:excludeFromRecents="true" />
        <activity android:name=".CameraPermissionActivity" android:exported="false" android:theme="@style/Theme.GeminiFloat" android:excludeFromRecents="true" />
        <activity android:name=".FilePickerActivity" android:exported="false" android:theme="@style/Theme.GeminiFloat" android:excludeFromRecents="true" />
        <service android:name=".AssistantAccessibilityService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="Buddy Shortcut">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
        </service>
        <service android:name=".FloatingAssistantService" android:exported="false" />
        <service android:name=".ScreenCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <service android:name=".LiveForegroundService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".CameraForegroundService" android:exported="false" android:foregroundServiceType="camera" />
        <service android:name=".VoiceKeyboardService" android:label="@string/voice_keyboard_label" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/voice_keyboard_method" />
        </service>
        <service
            android:name=".BuddyRecognitionService"
            android:label="Buddy speech recognition"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/buddy_recognition_service" />
        </service>
        <service
            android:name=".BuddyVoiceInteractionService"
            android:label="Buddy"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/buddy_voice_interaction" />
        </service>
        <service
            android:name=".BuddyVoiceInteractionSessionService"
            android:label="Buddy session"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />
    </application>
</manifest>
