<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_background"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="4dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/imeHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingEnd="3dp"
            android:text="Buddy keyboard"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/btnLanguage"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Switch English or Hindi"
            android:gravity="center"
            android:text="EN"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnOfflineKeyboard"
            android:layout_width="35dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Switch to offline keyboard"
            android:gravity="center"
            android:text="⌨"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/btnClipboard"
            android:layout_width="35dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Open clipboard history"
            android:gravity="center"
            android:text="▤"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="35dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Keyboard settings"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/btnMic"
            android:layout_width="35dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Start Gemini Live dictation"
            android:gravity="center"
            android:text="🎙"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/btnHideKeyboard"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Hide keyboard"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp"
        android:background="#263A414A" />

    <LinearLayout
        android:id="@+id/voicePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/btnDictate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/action_chip"
            android:backgroundTint="@color/accent_dark"
            android:gravity="center"
            android:text="●  Start Gemini Live dictation"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/quickKeysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/btnCustomizeKeys"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="⚙ Quick keys"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/offlinePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/suggestionContainer"
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/suggestion1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:background="#263A414A" />
            <TextView
                android:id="@+id/suggestion2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
            <View android:layout_width="1dp" android:layout_height="16dp" android:background="#263A414A" />
            <TextView
                android:id="@+id/suggestion3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="vertical" />
        <ScrollView
            android:id="@+id/clipboardScroll"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:fillViewport="false"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/clipboardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>
        <!-- Compatibility anchor for existing voice-panel toggle code. -->
        <View
            android:id="@+id/btnBackToVoice"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
