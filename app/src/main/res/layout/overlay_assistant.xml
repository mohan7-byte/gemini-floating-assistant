<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_background"
    android:elevation="24dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/floating_orb">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:id="@+id/waveformIcon"
                android:contentDescription="Buddy live audio visualizer"
                android:src="@drawable/ic_waveform" />
            <View
                android:id="@+id/liveStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="1dp"
                android:background="@drawable/live_status_dot" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/headerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvLiveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buddy"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="sans"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvModelBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Connecting securely…"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/actionsPager"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:contentDescription="Swipe left or right for more controls">

            <LinearLayout
                android:id="@+id/primaryActionPage"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnMute"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/action_chip"
                    android:contentDescription="Mute microphone"
                    android:padding="10dp"
                    android:src="@drawable/ic_mic" />

                <ImageView
                    android:id="@+id/btnScreenshot"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/action_chip"
                    android:contentDescription="Capture screenshot"
                    android:padding="10dp"
                    android:src="@drawable/ic_frame" />

                <ImageView
                    android:id="@+id/btnVoiceKeyboard"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/action_chip"
                    android:contentDescription="Open voice keyboard"
                    android:padding="10dp"
                    android:src="@drawable/ic_keyboard" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secondaryActionPage"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:alpha="0"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btnCamera"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/action_chip"
                    android:contentDescription="Open camera preview"
                    android:padding="10dp"
                    android:src="@drawable/ic_camera" />
                <ImageView
                    android:id="@+id/btnFiles"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/action_chip"
                    android:contentDescription="Choose a file"
                    android:padding="10dp"
                    android:src="@drawable/ic_file" />
                <ImageView
                    android:id="@+id/btnDisconnect"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/action_chip"
                    android:contentDescription="Disconnect Buddy"
                    android:padding="10dp"
                    android:src="@drawable/ic_close" />
                <ImageView
                    android:id="@+id/btnBackFromExtras"
                    android:layout_width="30dp"
                    android:layout_height="42dp"
                    android:contentDescription="Back to main controls"
                    android:padding="4dp"
                    android:src="@drawable/ic_chevron_left" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="38dp"
            android:layout_marginStart="3dp"
            android:background="@android:color/transparent"
            android:contentDescription="Minimize to floating button"
            android:padding="7dp"
            android:src="@drawable/ic_chevron_up" />

        <ImageView
            android:id="@+id/btnExpand"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="5dp"
        android:background="#3B414A" />

    <FrameLayout
        android:id="@+id/minimizedBubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="end"
        android:background="@drawable/floating_orb"
        android:contentDescription="Restore Buddy floating bar"
        android:visibility="gone">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:id="@+id/bubbleWaveformIcon"
            android:src="@drawable/ic_waveform" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/cameraPreviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/action_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp"
        android:visibility="gone">
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="112dp"
            android:layout_height="78dp"
            android:contentDescription="Live low-resolution camera preview"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starting camera…"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/btnCaptureCamera"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/action_chip"
                android:contentDescription="Send camera frame to Buddy"
                android:gravity="center"
                android:text="Ask Buddy"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnCloseCamera"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="Close preview"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expandedContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Connecting to Buddy…"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <ScrollView
            android:id="@+id/responseScroll"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:layout_marginTop="6dp"
            android:fillViewport="true">
            <TextView
                android:id="@+id/tvResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:padding="8dp"
                android:text="Live transcript appears here."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </ScrollView>
        <TextView
            android:id="@+id/btnCopyResponse"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="8dp"
            android:background="@drawable/action_chip"
            android:contentDescription="Copy response"
            android:gravity="center"
            android:text="⧉ Copy"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/input_background"
                android:hint="Message Buddy…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/floating_orb"
                android:contentDescription="Send message to Buddy"
                android:gravity="center"
                android:text="↑"
                android:textColor="@color/accent"
                android:textSize="23sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>